// Forks: change `account_id`, `routes`, `vars` and `database_id`, then follow the README.
// `workers_dev` stays off so that the rate limiting rule can't be bypassed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snap2link-relay",
  "account_id": "f92706131799f007365d2d12740ba400",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "routes": [{ "pattern": "i.snap2link.app", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snap2link-relay",
      "database_id": "9d0c08fc-fadb-4d88-b594-589c72c83ed2",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "snap2link-relay" }],
  "vars": {
    "PUBLIC_URL": "https://i.snap2link.app",
    "ABUSE_CONTACT": "abuse@snap2link.app",
    "MAIL_FROM": "Snap2Link <noreply@snap2link.app>",
    "TURNSTILE_SITEKEY": "0x4AAAAAAF0C_X7NcOtuLv5w"
  },
  // Links are refused the moment they expire: this only frees the space.
  "triggers": { "crons": ["*/30 * * * *"] },
  // Invocation logs would keep each request's headers, addresses included, for
  // days. Only what the code logs is kept: the privacy page promises that.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } }
}
