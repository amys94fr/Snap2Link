{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023", "esnext.typedarrays"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types",
      "node"
    ]
  },
  "include": ["src", "test", "vitest.config.ts"]
}
