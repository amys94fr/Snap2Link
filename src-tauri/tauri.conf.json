{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snap2Link",
  "version": "1.1.0",
  "identifier": "com.snap2link.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Snap2Link",
        "width": 480,
        "height": 580,
        "resizable": false,
        "center": true,
        "visible": false,
        "decorations": true,
        "url": "index.html"
      },
      {
        "label": "overlay",
        "title": "Snap2Link Overlay",
        "fullscreen": true,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "focus": true,
        "url": "index.html?window=overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/amys94fr/Snap2Link/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk4MTAxRkVFNzMxMEE1NjIKUldSaXBSQno3aDhRbUh1VXlYUkhqbmlvRG50aTR4REgxR1pkNEtHVmh1RUJMd2JZaU5jOStITTAK"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [],
    "category": "Productivity",
    "shortDescription": "Screenshot to Drive link",
    "longDescription": "Capture a screen region and instantly get a Google Drive share link in your clipboard.",
    "windows": {
      "wix": null,
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
